# ---- Application ----
NODE_ENV=development
PORT=3000
# Comma separated list of allowed origins, or * for all
CORS_ORIGIN=*

# ---- Database ----
# Local (matches docker-compose.yml / npm run db:start):
DATABASE_URL=postgres://kebab:kebab@localhost:5432/kebab_guide
# Set to true when your database requires SSL (e.g. managed cloud Postgres)
DATABASE_SSL=false

# ---- Migrations & data ----
# Run pending migrations automatically when the server boots
RUN_MIGRATIONS_ON_START=true
# Insert demo shops/ratings when running `npm run seed`
SEED_SAMPLE_DATA=true

# ---- Admin panel ----
# Must be at least 32 characters. Change it in production!
SESSION_SECRET=dev-session-secret-please-change-me!
ADMIN_EMAIL=admin@kebab.guide
ADMIN_PASSWORD=admin12345

# ---- Uploads ----
MAX_UPLOAD_MB=5

# ---- Rate limiting (public write endpoints) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
