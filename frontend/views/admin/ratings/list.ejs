<%- include('../partials/header', { title: title }) %>

<div class="page-head">
  <h1>Ratings</h1>
  <a class="btn btn-primary" href="/admin/ratings/new">+ New rating</a>
</div>

<div class="toolbar">
  <div class="chips">
    <a class="chip <%= status === 'all' ? 'chip-active' : '' %>" href="/admin/ratings">All</a>
    <a class="chip <%= status === 'pending' ? 'chip-active' : '' %>" href="/admin/ratings?status=pending">Pending</a>
    <a class="chip <%= status === 'validated' ? 'chip-active' : '' %>" href="/admin/ratings?status=validated">Validated</a>
  </div>
  <form method="get" action="/admin/ratings" class="search-form">
    <% if (status !== 'all') { %><input type="hidden" name="status" value="<%= status %>"><% } %>
    <% if (shopId) { %><input type="hidden" name="shopId" value="<%= shopId %>"><% } %>
    <input type="search" name="q" value="<%= search ?? '' %>" placeholder="Search notes or shop name...">
    <button type="submit" class="btn">Search</button>
  </form>
</div>

<div class="card">
  <% if (ratings.length === 0) { %>
    <p class="muted empty-state">No ratings found.</p>
  <% } else { %>
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th></th>
        <th>Shop</th>
        <th>Food</th><th>Price</th><th>Interior</th><th>Overall</th>
        <th>Notes</th><th>Status</th><th>Created</th>
        <th class="actions-col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% ratings.forEach(function (rating) { %>
      <tr>
        <td>
          <% if (rating.hasPhoto) { %>
            <img class="thumb" src="<%= rating.photoUrl %>" alt="" loading="lazy">
          <% } else { %>
            <div class="thumb thumb-empty"></div>
          <% } %>
        </td>
        <td><a href="/admin/shops/<%= rating.shopId %>"><%= rating.shopName ?? rating.shopId %></a></td>
        <td><%= rating.foodQualityRating %></td>
        <td><%= rating.priceFairRating %></td>
        <td><%= rating.interiorRating %></td>
        <td><%= helpers.fixed(rating.overallRating) %></td>
        <td class="muted"><%= helpers.truncate(rating.notes, 40) || '-' %></td>
        <td>
          <% if (rating.isValidated) { %><span class="badge badge-validated">Validated</span>
          <% } else { %><span class="badge badge-pending">Pending</span><% } %>
        </td>
        <td class="muted"><%= helpers.formatDate(rating.createdAt) %></td>
        <td class="actions-col">
          <div class="action-row">
            <a class="btn btn-sm" href="/admin/ratings/<%= rating.id %>/edit">Edit</a>
            <% if (rating.isValidated) { %>
              <form method="post" action="/admin/ratings/<%= rating.id %>/unvalidate">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="redirectTo" value="/admin/ratings<%= status !== 'all' ? '?status=' + status : '' %>">
                <button type="submit" class="btn btn-sm">Unvalidate</button>
              </form>
            <% } else { %>
              <form method="post" action="/admin/ratings/<%= rating.id %>/validate">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="redirectTo" value="/admin/ratings<%= status !== 'all' ? '?status=' + status : '' %>">
                <button type="submit" class="btn btn-success btn-sm">Validate</button>
              </form>
            <% } %>
            <form method="post" action="/admin/ratings/<%= rating.id %>/delete" data-confirm="Delete this rating?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="redirectTo" value="/admin/ratings">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>

<% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
<div class="pagination">
  <% if (pagination.prevUrl) { %><a class="btn btn-sm" href="<%= pagination.prevUrl %>">&larr; Previous</a><% } %>
  <span class="muted">Page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.total %> total)</span>
  <% if (pagination.nextUrl) { %><a class="btn btn-sm" href="<%= pagination.nextUrl %>">Next &rarr;</a><% } %>
</div>
<% } %>

<%- include('../partials/footer') %>
