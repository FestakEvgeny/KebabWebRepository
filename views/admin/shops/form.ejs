<%- include('../partials/header', { title: title }) %>

<div class="page-head">
  <h1><%= title %></h1>
  <a class="btn" href="/admin/shops">Back to shops</a>
</div>

<div class="card">
  <% if (errors && errors.length) { %>
    <div class="flash flash-error">
      <ul class="error-list">
        <% errors.forEach(function (error) { %><li><%= error %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="post" action="<%= action %>" enctype="multipart/form-data" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-field form-field-wide">
      <label for="name">Name *</label>
      <input id="name" name="name" type="text" maxlength="255" required
             value="<%= values?.name ?? shop?.name ?? '' %>">
    </div>

    <div class="form-field">
      <label for="latitude">Latitude * <span class="hint">(-90 to 90)</span></label>
      <input id="latitude" name="latitude" type="text" inputmode="decimal" required
             value="<%= values?.latitude ?? shop?.geo?.latitude ?? '' %>">
    </div>

    <div class="form-field">
      <label for="longitude">Longitude * <span class="hint">(-180 to 180)</span></label>
      <input id="longitude" name="longitude" type="text" inputmode="decimal" required
             value="<%= values?.longitude ?? shop?.geo?.longitude ?? '' %>">
    </div>

    <div class="form-field form-field-wide">
      <label for="photo">Photo <span class="hint">(image, max <%= 5 %> MB)</span></label>
      <input id="photo" name="photo" type="file" accept="image/*">
      <% if (shop && shop.hasPhoto) { %>
        <div class="photo-row">
          <img class="thumb thumb-lg" src="<%= shop.photoUrl %>" alt="Current photo">
          <label class="checkbox-label">
            <input type="checkbox" name="removePhoto"> Remove current photo
          </label>
        </div>
      <% } %>
    </div>

    <div class="form-field form-field-wide">
      <label class="checkbox-label">
        <input type="checkbox" name="isValidated"
          <% if (values?.isValidated === true || values?.isValidated === 'on' || values?.isValidated === 'true' || shop?.isValidated === true) { %>checked<% } %>>
        Validated (approved for the public app)
      </label>
      <p class="hint">New shops created through the public API always start as pending.</p>
    </div>

    <div class="form-actions form-field-wide">
      <button type="submit" class="btn btn-primary"><%= submitLabel %></button>
      <a class="btn" href="/admin/shops">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
